{
  "ServiceName": "PopcornMarket.OrderBook",
  "AllowedHosts": "*",
  "Persistence": {
    "ConnectionString": "Host=localhost;Port=5432;Database=popcorn_BabylonExchangeDB;Username=admin;Password=secret"
  },
  "Caching": {
    "Redis": {
      "ConnectionString": "localhost:6379"
    }
  },
  "Messaging": {
    "Kafka": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "orderBook.consumer.v1"
    }
  },
  "ElasticApm": {
    "ServerUrls": "http://localhost:8200",
    "ServiceName": "babylon-exchange",
    "Environment": "development",
    "CaptureBody": "all",
    "LogLevel": "Information"
  }
}

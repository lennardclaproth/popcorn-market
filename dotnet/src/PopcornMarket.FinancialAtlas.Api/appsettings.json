{
  "ServiceName": "PopcornMarket.FinancialAtlas",
  "AllowedHosts": "*",
  "Persistence": {
    "ConnectionString": "mongodb://localhost:27017/"
  },
  "Messaging": {
    "Kafka": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "financialAtlas.consumer.v1"
    }
  },
  "ElasticApm": {
    "ServerUrls": "http://localhost:8200",
    "ServiceName": "financial-atlas",
    "Environment": "development",
    "CaptureBody": "all",
    "LogLevel": "Information",
  }
}

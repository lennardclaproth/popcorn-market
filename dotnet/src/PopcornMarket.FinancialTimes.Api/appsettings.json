{
  "ServiceName": "PopcornMarket.FinancialTimes",
  "AllowedHosts": "*",
  "Persistence": {
    "ConnectionString": "mongodb://localhost:27017/"
  },
  "Messaging": {
    "Kafka": {
      "BootstrapServers": "localhost:9092",
      "GroupId": "financialTimes.consumer.v1"
    }
  },
  "ElasticApm": {
    "ServerUrls": "http://localhost:8200",
